# GenoRing managed instance "${INSTANCE_PROJECT}" served under "${INSTANCE_BASE_PATH}/".
# WARNING: This file is generated by genoring.pl ("attach" command). Any direct
# modification may be lost.
# SECURITY WARNING: the managed instance shares the web origin of current site.

RedirectMatch 301 "^${INSTANCE_BASE_PATH}$" "${INSTANCE_BASE_PATH}/"

# Proxied requests are not processed by current site rules (ie. PHP files).
<Location "${INSTANCE_BASE_PATH}/">
  # The request URI is passed unchanged (including the base path). The managed
  # instance proxy is resolved at request time ("disablereuse"): this proxy can
  # be (re)started even if the managed instance is not running.
  # Allow up to 5 minutes for a script to do its job.
  ProxyPass "http://${INSTANCE_PROXY}:${INSTANCE_PORT}${INSTANCE_BASE_PATH}/" disablereuse=On retry=0 timeout=300
  # Keep the port in forwarded host so Drupal can generate correct URLs.
  # Note: X-Forwarded-For and X-Forwarded-Host are added by mod_proxy_http.
  ProxyPreserveHost On
  RequestHeader set X-Real-IP "expr=%{REMOTE_ADDR}"
  RequestHeader set X-Forwarded-Proto "expr=%{REQUEST_SCHEME}"
  # Managed instance not reachable (ie. not running).
  ErrorDocument 500 "<!DOCTYPE html><html><head><title>Service unavailable</title></head><body><h1>Service temporarily unavailable</h1><p>This GenoRing instance is not available at the moment. Please try again later.</p></body></html>"
  ErrorDocument 502 "<!DOCTYPE html><html><head><title>Service unavailable</title></head><body><h1>Service temporarily unavailable</h1><p>This GenoRing instance is not available at the moment. Please try again later.</p></body></html>"
  ErrorDocument 503 "<!DOCTYPE html><html><head><title>Service unavailable</title></head><body><h1>Service temporarily unavailable</h1><p>This GenoRing instance is not available at the moment. Please try again later.</p></body></html>"
</Location>
