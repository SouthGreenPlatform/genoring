# Site base path "${BASE_PATH}".
# WARNING: This file is generated by genoring.pl from GENORING_BASE_PATH. Any
# direct modification may be lost.

# Use a relative redirection as the site is served by a master GenoRing
# instance (which may use another scheme or port).
<LocationMatch "^${BASE_PATH}$">
  RedirectRelative On
</LocationMatch>
RedirectMatch 301 "^${BASE_PATH}$" "${BASE_PATH}/"

# Serve the site under the base path. The original request URI and SCRIPT_NAME
# let Drupal know its base path.
Alias "${BASE_PATH}" "/opt/drupal/web"
