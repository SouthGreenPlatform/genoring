# Site base path "${BASE_PATH}".
# WARNING: This file is generated by genoring.pl from GENORING_BASE_PATH. Any
# direct modification may be lost.
set $genoring_base_path ${BASE_PATH};

location = ${BASE_PATH} {
  absolute_redirect off;
  return 301 ${BASE_PATH}/;
}

# Remove the base path and process the request as usual. The original request
# URI and SCRIPT_NAME let Drupal know its base path.
location ^~ ${BASE_PATH}/ {
  rewrite ^${BASE_PATH}(/.*)$ $1 last;
}
