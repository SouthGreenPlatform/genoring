# GenoRing managed instance "${INSTANCE_PROJECT}".
# WARNING: This file is generated by genoring.pl ("attach" command). Any direct
# modification may be lost.
server {

  listen ${NGINX_PORT};
${INSTANCE_SSL}
  server_name ${INSTANCE_HOST};

  # Use Docker embedded DNS server and resolve the managed instance proxy at
  # request time: this proxy can be (re)started even if the managed instance is
  # not running.
  resolver 127.0.0.11 valid=10s ipv6=off;

  location / {
    set $genoring_instance_upstream http://${INSTANCE_PROXY}:${INSTANCE_PORT};
    proxy_pass $genoring_instance_upstream;
    proxy_http_version 1.1;
    # Keep the port in forwarded host so Drupal can generate correct URLs.
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header X-Forwarded-Proto $scheme;
    # Allow up to 5 minutes for a script to do its job.
    proxy_read_timeout 5m;
    proxy_send_timeout 5m;
  }

  # Managed instance not reachable (ie. not running).
  error_page 502 504 = @genoring_instance_unavailable;
  location @genoring_instance_unavailable {
    default_type text/html;
    return 503 '<!DOCTYPE html><html><head><title>Service unavailable</title></head><body><h1>Service temporarily unavailable</h1><p>This GenoRing instance is not available at the moment. Please try again later.</p></body></html>';
  }
}
